      <aliases enabled='yes' />
      <column caption='Estado Supervivencia' datatype='string' name='[Calculation_1144195834079780864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Survived] = 1 THEN &quot;Sobrevivio&quot; ELSE &quot;No Sobrevivio&quot; END' />
      </column>
      <column caption='Grupo Etario' datatype='string' name='[Calculation_1144195834080047105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Age]) THEN &quot;N/A&quot;&#13;&#10;ELSEIF [Age] &lt; 12 THEN &quot;Niño/a&quot;&#13;&#10;ELSEIF [Age] &lt; 18 THEN &quot;Adolescente&quot;&#13;&#10;ELSEIF [Age] &lt; 30 THEN &quot;Joven&quot;&#13;&#10;ELSEIF [Age] &lt; 65 THEN &quot;Adulto&quot;&#13;&#10;ELSE &quot;ADULTO MAYOR&quot;&#13;&#10;END' />
      </column>
      <column caption='TOTAL PASAJEROS' datatype='integer' name='[Calculation_1144195834084507650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([PassengerId])' />
      </column>
      <column caption='KPI- SOBREVIVIENTES' datatype='integer' name='[Calculation_1144195834085953539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF[Survived] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='KPI-FALLECIDOS' datatype='integer' name='[Calculation_1144195834086305796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Survived] = 0  THEN 1 ELSE 0 END)' />
      </column>
      <column caption='KPI-TASA SUPERVIVENCIA' datatype='real' name='[Calculation_1144195834086592517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF[Survived] = 1 THEN 1 ELSE 0 END) / COUNT([PassengerId])' />
      </column>
      <column caption='Pais' datatype='string' name='[Calculation_1144195834088882182]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='CASE [Embarked] &#13;&#10;WHEN &quot;S&quot; THEN &quot;Reino Unido&quot; &#13;&#10;WHEN &quot;C&quot; THEN &quot;Francia&quot;&#13;&#10;WHEN &quot;Q&quot; THEN &quot;Irlanda&quot;&#13;&#10;ELSE &quot;N/A&quot;&#13;&#10;END' />
      </column>
      <column caption='Passenger Id' datatype='integer' name='[PassengerId]' role='dimension' type='ordinal' />
      <column caption='Sib Sp' datatype='integer' name='[SibSp]' role='measure' type='quantitative' />
